# ===== LABGUARD EDU — contoh konfigurasi (JANGAN isi secret asli di repo) =====
PORT=8080
NODE_ENV=production

# Mode autentikasi: "firebase" (produksi) atau "demo" (pengujian lokal, akun DEMO)
AUTH_MODE=firebase
# Penyimpanan data: "firestore" (produksi) atau "memory" (DEMO, disimpan ke file JSON lokal)
DATA_STORE=firestore
MEMORY_STORE_FILE=./data/demo-store.json

# Firebase Admin SDK — di Cloud Run gunakan Application Default Credentials (service account runtime).
# Untuk lokal: path ke file service account (di luar repo).
FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/aman/service-account.json

# Konfigurasi Firebase Web (bukan secret, dikirim ke browser melalui /api/public/config)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_WEB_APP_ID=

# Secret server (WAJIB diganti, minimal 32 karakter acak). Dipakai untuk
# enkripsi secret gateway (AES-256-GCM) dan token sesi mode demo.
SERVER_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Token sekali pakai untuk mendaftarkan Super Admin pertama
BOOTSTRAP_TOKEN=ganti-token-bootstrap

# CORS: daftar origin yang diizinkan, dipisah koma
CORS_ORIGINS=http://localhost:5173

# URL publik backend (dipakai di installer gateway & perangkat)
PUBLIC_BASE_URL=https://labguard.example.sch.id
